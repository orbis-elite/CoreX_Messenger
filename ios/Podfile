# -----------------------------------------------------------------------------
# Global iOS Platform
# -----------------------------------------------------------------------------

platform :ios, '14.0'

# -----------------------------------------------------------------------------
# CocoaPods Analytics
# -----------------------------------------------------------------------------
#
# Disabling analytics improves Flutter build speed.
#
# -----------------------------------------------------------------------------

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# -----------------------------------------------------------------------------
# Swift Version
# -----------------------------------------------------------------------------

ENV['SWIFT_VERSION'] = '5.0'

# -----------------------------------------------------------------------------
# Xcode Project Configuration
# -----------------------------------------------------------------------------

project 'Runner', {

  'Debug' => :debug,

  'Profile' => :release,

  'Release' => :release,
}

# =============================================================================
# Flutter Root Resolver
# =============================================================================

def flutter_root

  generated_xcode_build_settings_path =
      File.expand_path(

          File.join(
              '..',
              'Flutter',
              'Generated.xcconfig'
          ),

          __FILE__
      )

  unless File.exist?(generated_xcode_build_settings_path)

    raise(
        "#{generated_xcode_build_settings_path} must exist.\n" \
        "If you're running pod install manually,\n" \
        "make sure flutter pub get is executed first."
    )
  end

  File.foreach(generated_xcode_build_settings_path) do |line|

    matches = line.match(/FLUTTER_ROOT\=(.*)/)

    return matches[1].strip if matches
  end

  raise(
      "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}.\n" \
      "Try deleting Generated.xcconfig,\n" \
      "then run flutter pub get."
  )
end

# =============================================================================
# Flutter Pod Helper
# =============================================================================

require File.expand_path(

    File.join(
        'packages',
        'flutter_tools',
        'bin',
        'podhelper'
    ),

    flutter_root
)

flutter_ios_podfile_setup

# =============================================================================
# Runner Target
# =============================================================================

target 'Runner' do

  # ---------------------------------------------------------------------------
  # Framework Support
  # ---------------------------------------------------------------------------

  use_frameworks!

  use_modular_headers!

  # ---------------------------------------------------------------------------
  # Flutter Pods
  # ---------------------------------------------------------------------------

  flutter_install_all_ios_pods(
      File.dirname(File.realpath(__FILE__))
  )

  # ---------------------------------------------------------------------------
  # Runner Tests
  # ---------------------------------------------------------------------------

  target 'RunnerTests' do

    inherit! :search_paths
  end
end

# =============================================================================
# Post Install Configuration
# =============================================================================

post_install do |installer|

  installer.pods_project.targets.each do |target|

    flutter_additional_ios_build_settings(target)

    # -------------------------------------------------------------------------
    # Build Configurations
    # -------------------------------------------------------------------------

    target.build_configurations.each do |config|

      # -----------------------------------------------------------------------
      # iOS Deployment Target
      # -----------------------------------------------------------------------

      config.build_settings[
          'IPHONEOS_DEPLOYMENT_TARGET'
      ] = '14.0'

      # -----------------------------------------------------------------------
      # Swift Version
      # -----------------------------------------------------------------------

      config.build_settings[
          'SWIFT_VERSION'
      ] = '5.0'

      # -----------------------------------------------------------------------
      # Active Architecture
      # -----------------------------------------------------------------------

      config.build_settings[
          'ONLY_ACTIVE_ARCH'
      ] = 'NO'

      # -----------------------------------------------------------------------
      # Build Distribution
      # -----------------------------------------------------------------------

      config.build_settings[
          'BUILD_LIBRARY_FOR_DISTRIBUTION'
      ] = 'YES'

      # -----------------------------------------------------------------------
      # Excluded Architectures
      # -----------------------------------------------------------------------
      #
      # Helps older Intel Macs & Codemagic stability.
      #
      # -----------------------------------------------------------------------

      config.build_settings[
          "EXCLUDED_ARCHS[sdk=iphonesimulator*]"
      ] = "i386"

      # -----------------------------------------------------------------------
      # Permission Handler Macros
      # -----------------------------------------------------------------------

      config.build_settings[
          'GCC_PREPROCESSOR_DEFINITIONS'
      ] ||= [

        '$(inherited)',

        # ---------------------------------------------------------------------
        # Contacts
        # ---------------------------------------------------------------------

        'PERMISSION_CONTACTS=1',

        # ---------------------------------------------------------------------
        # Camera
        # ---------------------------------------------------------------------

        'PERMISSION_CAMERA=1',

        # ---------------------------------------------------------------------
        # Microphone
        # ---------------------------------------------------------------------

        'PERMISSION_MICROPHONE=1',

        # ---------------------------------------------------------------------
        # Photos
        # ---------------------------------------------------------------------

        'PERMISSION_PHOTOS=1',

        # ---------------------------------------------------------------------
        # Location
        # ---------------------------------------------------------------------

        'PERMISSION_LOCATION=1',

        'PERMISSION_LOCATION_WHENINUSE=0',

        # ---------------------------------------------------------------------
        # Notifications
        # ---------------------------------------------------------------------

        'PERMISSION_NOTIFICATIONS=1',

        # ---------------------------------------------------------------------
        # Media Library
        # ---------------------------------------------------------------------

        'PERMISSION_MEDIA_LIBRARY=1',
      ]
    end
  end

  sdwebimage_metadata =
      File.join(
          installer.sandbox.root.to_s,
          'SDWebImage',
          'SDWebImage',
          'Core',
          'UIImage+Metadata.m'
      )

  if File.exist?(sdwebimage_metadata)

    contents = File.read(sdwebimage_metadata)

    contents.gsub!(
        'return self.isHighDynamicRange;',
        'return [SDImageCoderHelper CGImageIsHDR:self.CGImage];'
    )

    File.chmod(0644, sdwebimage_metadata)

    File.write(sdwebimage_metadata, contents)
  end

  sdwebimage_animated_coder =
      File.join(
          installer.sandbox.root.to_s,
          'SDWebImage',
          'SDWebImage',
          'Core',
          'SDImageIOAnimatedCoder.m'
      )

  if File.exist?(sdwebimage_animated_coder)

    contents = File.read(sdwebimage_animated_coder)

    contents.gsub!(
        /    if \(@available\(macOS 14, iOS 17, tvOS 17, watchOS 10, \*\)\) \{\n        if \(decodeToHDR\) \{\n            decodingOptions\[\(__bridge NSString \*\)kCGImageSourceDecodeRequest\] = \(__bridge NSString \*\)kCGImageSourceDecodeToHDR;\n        \} else \{\n            decodingOptions\[\(__bridge NSString \*\)kCGImageSourceDecodeRequest\] = \(__bridge NSString \*\)kCGImageSourceDecodeToSDR;\n        \}\n    \}\n/m,
        ''
    )

    File.chmod(0644, sdwebimage_animated_coder)

    File.write(sdwebimage_animated_coder, contents)
  end
end

# =============================================================================
